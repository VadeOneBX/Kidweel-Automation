# ==========================================
# QOPS Options Engine - Environment Template
# Copy this to .env and fill in your keys
# ==========================================

# --- Alpaca Trading API (Paper/Live) ---
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here
# APCA_API_BASE_URL=https://paper-api.alpaca.markets # Uncomment for paper

# --- Databento API (Legacy/Fallback) ---
DATABENTO_API_KEY=your_databento_key_here

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backtesting Overrides ---
BT_OUT_DIR=data/backtests
BT_MODE=CALL_SPREAD