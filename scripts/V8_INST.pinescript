//@version=6
strategy("ORB 15m • High-Delta Institutional",
     shorttitle="V8-Delta",
     overlay=true, 
     pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, 
     default_qty_value=10)

// ───────────────────────────────────────────────────────────────
// Opening Range & Time Controls
// ───────────────────────────────────────────────────────────────
groupOR  = "Opening Range"
tz       = input.string("America/New_York", "Timezone (IANA)", group=groupOR)
orSess   = input.session("0930-0945", "OR Session (15m)", group=groupOR)
tradeWin = input.session("0930-1600", "Trading Window", group=groupOR)
allowRunTillClose = input.bool(true, "Run healthy trades till close", group=groupOR)

allowLongs   = input.bool(true,  "Allow Longs",  group="Trading")
allowShorts  = input.bool(true,  "Allow Shorts", group="Trading")
dailyOnlyOne = input.bool(false, "At most one trade per side per day", group="Trading")

// ───────────────────────────────────────────────────────────────
// SG Walls Conductor (Gamma Levels)
// ───────────────────────────────────────────────────────────────
groupSG        = "SG Walls Conductor"
useSGConductor = input.bool(true, "Block entries at SG walls", group=groupSG)
sgCallWall     = input.float(0.0, "Call wall", group=groupSG, step=0.01)
sgPutWall      = input.float(0.0, "Put wall", group=groupSG, step=0.01)
sgHedgeWall    = input.float(0.0, "Hedge wall", group=groupSG, step=0.01)
sgTolPct       = input.float(0.005, "Wall tolerance (0.5%)", group=groupSG, step=0.001)

atCallWall   = sgCallWall > 0 and math.abs(close - sgCallWall) / sgCallWall <= sgTolPct
atPutWall    = sgPutWall > 0 and math.abs(close - sgPutWall) / sgPutWall <= sgTolPct
atHedgeWall  = sgHedgeWall > 0 and math.abs(close - sgHedgeWall) / sgHedgeWall <= sgTolPct
okToLongSG   = not useSGConductor or (not atCallWall and not atHedgeWall)
okToShortSG  = not useSGConductor or (not atPutWall and not atHedgeWall)

// ───────────────────────────────────────────────────────────────
// Tightened Parameters
// ───────────────────────────────────────────────────────────────
groupST  = "Stops/Targets"
sectorPreset = input.string("Index ETFs (SPY/QQQ)", "Sector Preset", group="Presets",
     options = ["Custom", "Index ETFs (SPY/QQQ)", "Communications (ASTS)", "Consumer Durables (TSLA)", "Electronic Tech - Mega (AVGO)", "Electronic Tech - Spec (IONQ/RGTI)", "Finance (OPEN/SOFI/HOOD/AFRM)", "Funds (MAGS/ARKK)", "Non-Energy Minerals (MP/UUUU)", "Producer Mfg (OKLO/SMR)", "Retail - Mega (AMZN)", "Retail - Micro (NEGG)", "Tech Services - CryptoBeta (IREN/MSTR)", "Tech Services - LargeCap (NFLX/ORCL)", "Tech Services - Growth (SOUN/U)"])

// Strict Institutional Caps
effStopMult   = 0.50  // 50% OR Range Stop
effTargetMult = 1.50  // Standard Target
effVolMult    = 1.20  // Minimum Volume Spike

// ───────────────────────────────────────────────────────────────
// Opening Range & Repaint-Safe Data
// ───────────────────────────────────────────────────────────────
var float orh = na, var float orl = na, var float orm = na
var bool or_done = false, var bool or_token = false
or_sesh = not na(time(timeframe.period, orSess, tz))
or_start = or_sesh and not or_sesh[1]
or_end = or_sesh[1] and not or_sesh

if or_start
    orh := high, orl := low, or_token := false
if or_sesh
    orh := math.max(nz(orh, high), high)
    orl := math.min(nz(orl, low), low)
    if orh != orl
        or_token := true
if or_end and or_token
    orm := math.avg(orh, orl), or_done := true

orw = or_token ? (orh - orl) : na
inTradeWindow = not na(time(timeframe.period, tradeWin, tz))

// Security Requests (Repaint-Safe)
c3 = request.security(syminfo.tickerid, "3", close, lookahead=barmerge.lookahead_off)
v3 = request.security(syminfo.tickerid, "3", volume, lookahead=barmerge.lookahead_off)
sV3 = request.security(syminfo.tickerid, "3", ta.sma(volume, 9), lookahead=barmerge.lookahead_off)
xup3 = request.security(syminfo.tickerid, "3", ta.crossover(close, orh), lookahead=barmerge.lookahead_off)
xdown3 = request.security(syminfo.tickerid, "3", ta.crossunder(close, orl), lookahead=barmerge.lookahead_off)

// Institutional Health (VWAP + Vol Delta)
vwapSeries = ta.vwap(close)
volDelta = ta.cum(close > open ? volume : -volume)
longStillHealthy  = close > vwapSeries and ta.change(volDelta) >= 0
shortStillHealthy = close < vwapSeries and ta.change(volDelta) < 0

volOK3 = v3 >= effVolMult * sV3
validOR = or_done and or_token and orw > 0
canTrade = inTradeWindow and validOR

// ───────────────────────────────────────────────────────────────
// Tightened Stops & Logical Exits
// ───────────────────────────────────────────────────────────────
longTarget  = orh + effTargetMult * orw
shortTarget = orl - effTargetMult * orw
longStop    = orh - (effStopMult * orw)
shortStop   = orl + (effStopMult * orw)

exitForLong(eid, xid) =>
    if allowRunTillClose and longStillHealthy
        strategy.exit(xid, from_entry=eid, stop=longStop, limit=na, comment="Riding Trend")
    else
        strategy.exit(xid, from_entry=eid, stop=longStop, limit=longTarget, comment="Target/Mid-Stop")

exitForShort(eid, xid) =>
    if allowRunTillClose and shortStillHealthy
        strategy.exit(xid, from_entry=eid, stop=shortStop, limit=na, comment="Riding Trend")
    else
        strategy.exit(xid, from_entry=eid, stop=shortStop, limit=shortTarget, comment="Target/Mid-Stop")

// ───────────────────────────────────────────────────────────────
// Execution
// ───────────────────────────────────────────────────────────────
longEntry  = canTrade and allowLongs and okToLongSG and xup3 and volOK3
shortEntry = canTrade and allowShorts and okToShortSG and xdown3 and volOK3

if longEntry
    strategy.entry("L", strategy.long, comment="ORB Long")
    exitForLong("L", "LX")
if shortEntry
    strategy.entry("S", strategy.short, comment="ORB Short")
    exitForShort("S", "SX")

if not allowRunTillClose and not inTradeWindow
    strategy.close_all(comment="EOD Flatten")

// ───────────────────────────────────────────────────────────────
// UI
// ───────────────────────────────────────────────────────────────
plot(orm, "OR Mid", color=color.new(color.gray, 50), style=plot.style_linebr)
var table badge = table.new(position.top_right, 1, 1, bgcolor=color.new(color.gray, 85))
table.cell(badge, 0, 0, "Preset: " + sectorPreset, text_color=color.white, text_size=size.tiny)

